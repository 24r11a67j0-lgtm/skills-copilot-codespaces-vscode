# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# YouTube Data API v3 Key (required for YouTube channel analysis)
YOUTUBE_API_KEY=AIza...

# ChromaDB persistence directory (optional, defaults to ./chroma_db)
CHROMA_PERSIST_DIR=./chroma_db

# OpenAI model to use for chat (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# OpenAI embedding model (optional, defaults to text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
